                                    <tr>
                                        <td><span class="route-circle small-circle" style="background-color: green;">7</span> Ruta 7</td>
                                        <td>05:00 AM - 09:00 PM</td>
                                        <td>05:00 AM - 08:00 PM</td>
                                        <td>06:00 AM - 08:00 PM</td>
                                        <td>8-12 min</td>
                                    </tr>
                                    <tr>
                                        <td><span class="route-circle small-circle" style="background-color: red;">12</span> Ruta 12</td>
                                        <td>04:30 AM - 09:00 PM</td>
                                        <td>04:30 AM - 09:00 PM</td>
                                        <td>04:30 AM - 09:00 PM</td>
