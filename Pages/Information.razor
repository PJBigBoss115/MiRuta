<section class="py-5 bg-light" id="reglas">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Reglas y Normativas</h2>
        
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-warning text-dark">
                        <h4 class="m-0"><i class="bi bi-exclamation-triangle me-2"></i>Normas de Conducta</h4>
                    </div>
                    <div class="card-body">
                        <div class="rule-item">
                            <h5><i class="bi bi-1-circle text-primary me-2"></i>Comportamiento</h5>
                            <p class="mb-0">Mantenga un comportamiento respetuoso con otros pasajeros y el personal del transporte.</p>
                        </div>
                        <div class="rule-item">
                            <h5><i class="bi bi-2-circle text-primary me-2"></i>Prioridad de Asientos</h5>
                            <p class="mb-0">Ceda los asientos prioritarios a adultos mayores, embarazadas y personas con discapacidad.</p>
                        </div>
                        <div class="rule-item">
                            <h5><i class="bi bi-3-circle text-primary me-2"></i>Uso de Mascarillas</h5>
                            <p class="mb-0">Utilice mascarilla en caso de síntomas respiratorios para proteger a otros pasajeros.</p>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-danger text-white">
                        <h4 class="m-0"><i class="bi bi-x-circle me-2"></i>Prohibiciones</h4>
                    </div>
                    <div class="card-body">
                        <div class="rule-item">
                            <h5><i class="bi bi-ban text-danger me-2"></i>Alimentos y Bebidas</h5>
                            <p class="mb-0">No consumir alimentos ni bebidas dentro de las unidades de transporte.</p>
                        </div>
                        <div class="rule-item">
                            <h5><i class="bi bi-ban text-danger me-2"></i>Límite de equipaje</h5>
                            <p class="mb-0">Solo se permiten maletas de 25x40x60 cm. Los domingos no aplica esta restricción.</p>
                        </div>
                        <div class="rule-item">
                            <h5><i class="bi bi-ban text-danger me-2"></i>Fumar/Vapear</h5>
                            <p class="mb-0">Estrictamente prohibido fumar o vapear en las unidades y paradas.</p>
                        </div>
                        <div class="rule-item">
                            <h5><i class="bi bi-ban text-danger me-2"></i>Animales</h5>
                            <p class="mb-0">No se permiten animales, excepto perros guía debidamente identificados.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5" id="tarifas">
    <div class="container">
        <h2 class="text-center fw-bold mb-5">Tarifas y Métodos de Pago</h2>
        
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <div class="feature-icon bg-primary text-white mx-auto">
                            <i class="bi bi-credit-card"></i>
                        </div>
                        <h4>Tarjeta Recargable</h4>
                        <p>Adquiere tu tarjeta en estaciones autorizadas y recárgala según tus necesidades.</p>
                        <div class="mt-3">
                            <span class="badge bg-primary fs-6">Costo: Q5.00</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <div class="feature-icon bg-success text-white mx-auto">
                            <i class="bi bi-cash"></i>
                        </div>
                        <h4>Tarifa Regular</h4>
                        <p>Pago por viaje con tarjeta recargable. Aplicable a todos los usuarios.</p>
                        <div class="mt-3">
                            <span class="badge bg-success fs-6">Q1.00 por viaje</span>
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="col-md-4">
                <div class="card text-center shadow-sm h-100">
                    <div class="card-body">
                        <div class="feature-icon bg-info text-white mx-auto">
                            <i class="bi bi-person-hearts"></i>
                        </div>
                        <h4>Tarifas Preferenciales</h4>
                        <p>Descuentos para adultos mayores, estudiantes y personas con discapacidad.</p>
                        <div class="mt-3">
                            <span class="badge bg-info fs-6">50% de descuento</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

