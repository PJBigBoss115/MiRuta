@page "/information"

<PageTitle>Información</PageTitle>

<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-4 fw-bold mb-3">Sistema de Transporte Urbano</h1>
                <p class="lead mb-4">Movilidad eficiente, segura y accesible para todos los ciudadanos</p>
                <div class="d-flex gap-3 flex-wrap">
                    <span class="badge bg-light text-dark fs-6 p-2"><i class="bi bi-clock me-1"></i> Horarios Extendidos</span>
                    <span class="badge bg-light text-dark fs-6 p-2"><i class="bi bi-geo-alt me-1"></i> Cobertura Total</span>
                    <span class="badge bg-light text-dark fs-6 p-2"><i class="bi bi-shield-check me-1"></i> Viaje Seguro</span>
                </div>
            </div>
            <div class="col-lg-4 text-center">
                <i class="bi bi-bus-front display-1 opacity-75"></i>
            </div>
        </div>
    </div>
</section>

<section class="py-5 bg-light" id="rutas">
