                                        <td><span class="route-circle small-circle" style="background-color: blue;">18</span> Ruta 18</td>
                                        <td>05:00 AM - 09:00 PM</td>
                                        <td>05:00 AM - 08:00 PM</td>
                                        <td>06:00 AM - 08:00 PM</td>
                                        <td>15-20 min</td>
