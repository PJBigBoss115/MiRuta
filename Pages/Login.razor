@page "/login"
@layout AuthLayout
@inject NavigationManager Navigation

<div class="login-container">
    <div class="auth-card">
        <div class="card">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="logo-icon">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <h2 class="text-dark mt-3 fw-bold">Bienvenido a MiRuta</h2>
                    <p class="text-muted">Accede a tu cuenta</p>
                </div>
                
                <form>
                    <div class="form-floating mb-3">
                        <input type="email" class="form-control" id="email" placeholder="nombre@ejemplo.com">
                        <label for="email">
                            <i class="bi bi-envelope me-2"></i>Correo
                        </label>
                    </div>
                    
                    <div class="form-floating mb-4">
                        <input type="password" class="form-control" id="password">
                        <label for="password">
                            <i class="bi bi-lock me-2"></i>Contraseña
                        </label>
                    </div>

                    <div class="d-grid">
                        <button type="button" class="btn btn-success btn-lg fw-bold py-3" @onclick="RedirectToHome">
                            <i class="bi bi-box-arrow-in-right me-2"></i>
                            Iniciar Sesión
                        </button>
                    </div>
                </form>
                
                <div class="text-center mt-4">
                    <a href="#" class="text-success text-decoration-none small me-3">
                        <i class="bi bi-question-circle me-1"></i>¿Olvidaste tu contraseña?
                    </a>
                    <a href="register" class="btn btn-outline-success btn-sm">
                        <i class="bi bi-person-plus me-1"></i>Crear Cuenta
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private void RedirectToHome()
    {
        Navigation.NavigateTo("information");
    }
}
