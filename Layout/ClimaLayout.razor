<div class="weather-card">
    <div class="container">
        <div id="weatherLoading" class="text-center d-none">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="mt-2">Cargando clima...</p>
        </div>

        <div id="weatherContent" class="d-none weather-horizontal">
            <div class="weather-left">
                <img id="weatherIcon" src="" alt="Icono del clima" class="weather-icon">
                <div>
                    <h4 id="weatherCity" class="fw-bold"></h4>
                    <h2 id="weatherTemp" class="fw-bold text-primary"></h2>
                    <p id="weatherDescription" class="text-white"></p>
                </div>
            </div>

            <div class="weather-right">
                <div>
                    <small class="text-white d-block">Humedad</small>
                    <span id="weatherHumidity" class="fw-semibold d-block"></span>
                </div>
                <div class="mt-1">
                    <small class="text-white d-block">Viento</small>
                    <span id="weatherWind" class="fw-semibold d-block"></span>
                </div>
            </div>
        </div>

        <div id="weatherError" class="text-center d-none">
            <i class="bi bi-exclamation-triangle text-warning" style="font-size: 1.5rem;"></i>
            <p class="mt-1 text-white">No se pudo cargar el clima</p>
        </div>
    </div>
</div>
