<div class="searchContainer">
    <div class="container mt-2 mb-4">
        <div class="search-header">
            <h2 class="search-title">
                <i class="bi bi-geo-alt-fill me-2"></i>Encuentra tu destino
            </h2>
            <p class="search-subtitle">Busca lugares, parques, centros comerciales y más en la ciudad</p>
        </div>

        <div class="row justify-content-center">
            <div class="col-md-6">
                <label for="destinationInput" class="form-label">¿A dónde quieres ir?</label>
                <div class="input-group">
                    <input type="text" 
                           class="form-control" 
                           id="searchInput" 
                           placeholder="Ej. Parque Central, Centro Histórico, Kaminal Juyú...">
                    <button class="btn btn-primary" type="button" id="searchBtn">
                        <i class="bi bi-search me-1"></i>Buscar
                    </button>
                </div>
            </div>
        </div>
        
        <div class="row justify-content-center">
            <div class="col-md-12">
                <ul id="searchResults" class="list-group mt-2 mb-4"></ul>
            </div>
        </div>
    </div>
</div>

